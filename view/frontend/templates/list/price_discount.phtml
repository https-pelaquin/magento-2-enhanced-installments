/** @var \Pelaquin\EnhancedInstallments\Block\Lists\PriceDiscount $block */
/** @var \Magento\Framework\Escaper $escaper */

$product = $block->getProduct();
$discountPercent = $block->getDiscountPercent();

if ($discountPercent <= 0) {
    return;
}

$elementId = 'bp-billet-price-' . (int) $product->getId() . '-' . uniqid();
?>
<span id="<?= $escaper->escapeHtmlAttr($elementId) ?>"
      data-role="priceBox"
      data-price-type="finalPrice"
      class="price-wrapper"></span>
<div class="msg-discount">
    <?= $escaper->escapeHtml(__($block->getText(), $discountPercent)) ?>
</div>
<script type="text/x-magento-init">
<?= /* @noEscape */ $block->getWidgetConfig($product, $elementId) ?>
</script>
