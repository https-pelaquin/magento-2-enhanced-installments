/** @var \Pelaquin\EnhancedInstallments\Block\Product\PriceDiscount $block */
/** @var \Magento\Framework\Escaper $escaper */

$pixDiscount = $block->getPaymentDiscount('pix');
$bankSlipDiscount = $block->getPaymentDiscount('boleto');
$discounts = [
    [
        'elementId' => 'bp-pix-price',
        'percentage' => $pixDiscount,
        'message' => __('Special PIX price with %1% discount', $pixDiscount),
    ],
    [
        'elementId' => 'bp-bank-slip-discount',
        'percentage' => $bankSlipDiscount,
        'message' => __('Special bank slip price with %1% discount', $bankSlipDiscount),
    ],
];

if ($bankSlipDiscount > $pixDiscount) {
    $discounts = array_reverse($discounts);
}

$discounts = array_values(array_filter(
    $discounts,
    static fn (array $discount): bool => $discount['percentage'] > 0
));
?>
<?php if ($discounts !== []): ?>
    <?php foreach ($discounts as $index => $discount): ?>
        <?php if ($index === 0): ?>
            <div class="main-price-discount">
                <span id="<?= $escaper->escapeHtmlAttr($discount['elementId']) ?>"
                      data-role="priceBox"
                      data-price-type="finalPrice"
                      class="price-wrapper"></span>
                <div class="msg-discount">
                    <?= $escaper->escapeHtml($discount['message']) ?>
                </div>
            </div>
        <?php else: ?>
            <div class="msg-discount-wrapper">
                <div class="msg-discount">
                    <strong id="<?= $escaper->escapeHtmlAttr($discount['elementId']) ?>"
                            data-role="priceBox"></strong>
                    <?= $escaper->escapeHtml($discount['message']) ?>
                </div>
            </div>
        <?php endif; ?>
    <?php endforeach; ?>

    <script type="text/x-magento-init">
    <?= /* @noEscape */ $block->getWidgetConfig($pixDiscount, $bankSlipDiscount) ?>
    </script>
<?php endif; ?>
