<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="category.product.type.details.renderers.default" template="Pelaquin_EnhancedInstallments::list/details_wrapper.phtml">
            <block class="Pelaquin\EnhancedInstallments\Block\Lists\PriceDiscount"
                   name="bp.list.price.discount"
                   as="bp_list_price_discount"
                   ifconfig="bp_installment_billet_price/general/active"
                   template="Pelaquin_EnhancedInstallments::list/price_discount.phtml"/>
                   
            <block class="Pelaquin\EnhancedInstallments\Block\Lists\Installment"
                   name="bp.list.installment"
                   as="bp_list_installment"
                   ifconfig="bp_installment_billet_price/general/active"
                   template="Pelaquin_EnhancedInstallments::list/installment.phtml"/>
        </referenceBlock>
    </body>
</page>
