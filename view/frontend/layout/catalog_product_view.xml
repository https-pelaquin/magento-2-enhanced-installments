<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.price">
            <block class="Pelaquin\EnhancedInstallments\Block\Product\PriceDiscount"
                name="bp.product.price.discount"
                template="Pelaquin_EnhancedInstallments::product/price_discount.phtml"
                after="product.price.final"
                ifconfig="bp_enhanced_installments/general/active" />
            <block class="Pelaquin\EnhancedInstallments\Block\Product\Installment"
                name="bp.product.installment"
                template="Pelaquin_EnhancedInstallments::product/installment.phtml"
                after="bp.product.price.discount"
                ifconfig="bp_enhanced_installments/general/active" />
        </referenceContainer>
    </body>
</page>
