{
    "name": "pelaquin/module-enhanced-installments",
    "description": "PIX and bank slip discounts with credit card installment displays for Magento 2.",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": [
        "magento2",
        "pix",
        "bank-slip",
        "boleto",
        "installments",
        "payment-discount"
    ],
    "homepage": "https://github.com/https-pelaquin/EnhancedInstallments",
    "authors": [
        {
            "name": "Bruno Pelaquin",
            "homepage": "https://github.com/https-pelaquin",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/https-pelaquin/EnhancedInstallments/issues",
        "source": "https://github.com/https-pelaquin/EnhancedInstallments"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-json": "*",
        "magento/framework": "103.0.*",
        "magento/module-catalog": "104.0.*",
        "magento/module-catalog-widget": "100.4.*",
        "magento/module-checkout": "100.4.*",
        "magento/module-config": "101.2.*",
        "magento/module-customer": "103.0.*",
        "magento/module-eav": "102.1.*",
        "magento/module-store": "101.1.*",
        "magento/module-ui": "101.2.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Pelaquin\\EnhancedInstallments\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pelaquin\\EnhancedInstallments\\Test\\": "Test/"
        }
    }
}
